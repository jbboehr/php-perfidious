{
    "name": "jbboehr/perfidious",
    "description": "PHP extension providing access to the performance monitoring counters exposed by the Linux perf_events kernel API",
    "type": "php-ext",
    "keywords": [
        "perf",
        "perf_events",
        "profiling",
        "performance",
        "pfm",
        "libpfm"
    ],
    "homepage": "https://github.com/jbboehr/php-perfidious",
    "license": "AGPL-3.0-only WITH romic-exception",
    "authors": [
        {
            "name": "John Boehr",
            "email": "jbboehr@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/jbboehr/php-perfidious/issues",
        "source": "https://github.com/jbboehr/php-perfidious"
    },
    "require": {
        "php": ">=8.1",
        "ext-spl": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.13.6"
    },
    "php-ext": {
        "extension-name": "perfidious",
        "os-families": [
            "linux"
        ],
        "configure-options": [
            {
                "name": "enable-perfidious-debug",
                "description": "Enable perfidious debug support"
            },
            {
                "name": "enable-perfidious-coverage",
                "description": "Enable perfidious coverage support"
            },
            {
                "name": "enable-perfidious-sanitize",
                "description": "Build perfidious with ASan and UBSan"
            },
            {
                "name": "enable-compile-warnings",
                "description": "Set the compiler warning level to no, yes, or error",
                "needs-value": true
            },
            {
                "name": "disable-Werror",
                "description": "Make compiler warnings non-fatal"
            }
        ]
    },
    "_comment": [
        "Think not that I am come to send peace on earth: I came not to send peace, but a sword. Matthew 10:34"
    ]
}
